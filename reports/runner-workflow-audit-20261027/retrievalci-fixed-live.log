rsafelyandrollbackifsomethinggoeswrong", "lookup_terms": ["recommended", "two-stage", "process", "rotating", "signing", "credentials", "used", "gpu", "image", "build", "promotion", "pipelines", "including", "cut", "safely", "roll"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": ["used by"], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "ENTITY_RELATIONAL", "modifiers": [], "reason_codes": ["RELATION_CUE_PRESENT"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
