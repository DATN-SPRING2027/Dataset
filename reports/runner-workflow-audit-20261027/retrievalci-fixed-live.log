oute": {"version": "query-flow-v1", "query_original": "In the incident writeup about KV cache ghost entries causing gradual memory growth and OOM during a surge, what metric name was added for counting when the sanitizer finds negative refcounts?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "KNOWLEDGE", "confidence": 0.8641, "model": "Kev-4b", "suggested_strategy": "vector", "requested_strategy": "auto", "effective_strategy": "vector", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["KNOWLEDGE_INTENT", "TEMPORAL_CUE"], "query_analysis": {"normalized_phrase": "intheincidentwriteupaboutkvcacheghostentriescausinggradualmemorygrowthandoomduringasurgewhatmetricnamewasaddedforcountingwhenthesanitizerfindsnegativerefcounts", "lookup_terms": ["incident", "writeup", "kv", "cache", "ghost", "entries", "causing", "gradual", "memory", "growth", "oom", "during", "surge", "metric", "name", "added"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": ["during"], "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "TEMPORAL", "modifiers": [], "reason_codes": ["TEMPORAL_CUE_PRESENT"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
