7, "rank_fusion": 35.74, "graph_expansion": 0.0, "diversity_selection": 1642.9, "total_retrieval": 4274.19}, "latency_total_ms": 4274.19, "automatic_top_k": true, "effective_top_k": 4, "adaptive_waves": 1, "retrieval_stop_reason": "relevance_plateau", "budget_exhausted": false, "has_more": false, "acl_filtered_candidates": 0, "query_route": {"version": "query-flow-v1", "query_original": "In the draft spec about extending a routing policy engine for automated regional failover, what is the proposed priority order for evaluating different failure signals when deciding whether to shift traffic or fail over?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "KNOWLEDGE", "confidence": 0.8089, "model": "Kev-4b", "suggested_strategy": "vector", "requested_strategy": "auto", "effective_strategy": "vector", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["KNOWLEDGE_INTENT"], "query_analysis": {"normalized_phrase": "inthedraftspecaboutextendingaroutingpolicyengineforautomatedregionalfailoverwhatistheproposedpriorityorderforevaluatingdifferentfailuresignalswhendecidingwhethertoshifttrafficorfailover", "lookup_terms": ["draft", "spec", "extending", "routing", "policy", "engine", "automated", "regional", "failover", "proposed", "priority", "order", "evaluating", "different", "failure", "signals"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "LOCAL_FACTUAL", "modifiers": [], "reason_codes": ["DEFAULT_LOCAL_FACTUAL"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
