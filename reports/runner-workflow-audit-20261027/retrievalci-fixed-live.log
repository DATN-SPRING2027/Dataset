ue}, "selection_fallback_reason": null, "stage_latencies_ms": {"auth_scope": 40.22, "tree_route": 661.26, "candidate_retrieval": 2035.17, "evidence_hydration": 28.01, "rank_fusion": 46.01, "graph_expansion": 0.0, "diversity_selection": 2136.1, "total_retrieval": 4961.23}, "latency_total_ms": 4961.23, "automatic_top_k": true, "effective_top_k": 5, "adaptive_waves": 1, "retrieval_stop_reason": "relevance_plateau", "budget_exhausted": false, "has_more": false, "acl_filtered_candidates": 0, "query_route": {"version": "query-flow-v1", "query_original": "What is the name of the new metric added so SRE can track when server-side streaming sessions get finalized due to hitting the time limit?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "KNOWLEDGE", "confidence": 0.939, "model": "Kev-4b", "suggested_strategy": "vector", "requested_strategy": "auto", "effective_strategy": "vector", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["KNOWLEDGE_INTENT"], "query_analysis": {"normalized_phrase": "whatisthenameofthenewmetricaddedsosrecantrackwhenserversidestreamingsessionsgetfinalizedduetohittingthetimelimit", "lookup_terms": ["name", "new", "metric", "added", "so", "sre", "track", "server-side", "streaming", "sessions", "get", "finalized", "due", "hitting", "time", "limit"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "LOCAL_FACTUAL", "modifiers": [], "reason_codes": ["DEFAULT_LOCAL_FACTUAL"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
13:59:39  DEBUG    [8d09852bdd2743ff]  sse_starlette.sse  chunk: b'event: summary.delta\r\ndata: {"delta": "The new metric added to track when server-side streaming sessions get finalized due to hitting the time limit is \\"stream.timebox_finalized\\" with labels for route and model. This metric was introduced as part of the changes in Pr 129874 [1]."}\r\n\r\n'
13:59:39  DEBUG    [8d09852bdd2743ff]  sse_starlette.sse  chunk: b'event: completed\r\ndata: {"query": "What is the name of the new metric added so SRE can track when server-side streaming sessions get finalized due to hitting the time limit?", "sections": [{"chunk_id": "77ccfbb4-2766-53e1-9c48-7d6a54f34ff5", "search_unit_id": "77ccfbb4-2766-53e1-9c48-7d6a54f34ff5", "block_from_id": "1402985c-6c5e-5c98-ae84-7896c4a28772", "block_to_id": "1402985c-6c5e-5c98-ae84-7896c4a28772", "section_path": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "document_id": "6462f8ed-eae8-5b6d-a5f1-30143420f402", "document_version_id": "fa43fa2f-e842-5aa1-9ba5-06c4e55756a2", "document_name": "github__dsid_9550250a59e74f1bbd5612480b2e7100.md", "version_no": 1, "page_from": 1, "page_to": 1, "anchor": "p-2", "heading": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "content": "Context: production customers observed cases where long lived streaming sessions (tool calls + structured output) were left in indeterminate states after a client network disconnect or a client-initiated Cancel. Motivation: we need a predictable server-side safety net that bounds resource residency time, ensures tool-call idempotency when retries/resume occur, and provides a clear fallback path (trimmed response + final event) that OpenAI-compatible clients can rely on. This PR implements a server-side streaming timebox (configurable per-route) that gracefully converts oversized/inflight streams into a final \'timeboxed\' terminal event, augments client-cancel handling to be idempotent across reconnect/resume windows, and plumbs a compact resume token that includes tool-call idempotency metadata. Summary of changes: 1) stream manager: add configurable timebox_ms and a deterministic finalization path that emits a structured terminal event (\\"__redwood_timeboxed__\\") with a compact summary; 2) openai adapter: interpret Cancel events as idempotent markers tied to resume tokens; retries within the resume window will deduplicate tool calls using a request-level id; 3) tooling: map function-call invocations to idempotency keys and persist minimal call metadata to the stream checkpoint to support safe resume; 4) API: extend the OpenAI-compat streaming spec with two optional fields in the final event (timeboxed=true, resume_hint) without breaking existing clients; 5) tests & docs: integration tests for flaky network simulated disconnects and release notes for the behavior and recommended operational knobs. Rollout plan: feature guarded behind a runtime flag and route-level config. Backwards compatibility: default behavior is unchanged unless a route opts-in. Checklist: [x] unit tests for stream finalizer [x] integration test that simulates disconnect + resume [x] docs page and compatibility notes [x] change log entry. Related: ENG-1023 (stream lifecycle SLO), SUP-4572 (customer incident replicant).\\nstream: add timebox lifecycle and finalizer logic (runtime)\\ncompat: interpret cancel as idempotent marker with resume token (openai adapter)\\nstream: persist minimal tool-call idempotency metadata to checkpoints\\napi: add \'timeboxed\' and \'resume_hint\' flags to streaming final event schema\\ntests: integration tests for disconnect/resume/timebox behavior\\ndocs: add streaming-lifecycle/timebox operational runbook\\nAva Chen (2026-02-19): Nice approach. Two asks: 1) can we make the default timebox conservative (eg 30s) and 2) add metrics for timebox-triggered finalizations so SRE can track this?\\nMarcus Li (2026-02-19): Thanks Ava. Default is 30s in the flags; added metric \'stream.timebox_finalized\' with labels route/model; will push change.\\nDiego Martinez (2026-02-20): Concern about persisting tool-call metadata on every request path. How big can the checkpoint grow? What retention semantics?\\nMarcus Li (2026-02-20): Checkpoints store only a 64-bit idempotency hash + 3-field small metadata (call name, timestamp, status). We GC per-checkpoint on successful terminalization. Size is bounded and measured in tests.\\nPriya Nair (2026-02-21): Integration test flaky on first run, failure in \'resume-after-disconnect\' when the simulated retry arrives slightly after timebox expiry. Can we make the test deterministic?\\nMarcus Li (2026-02-21): Fixed by injecting a deterministic clock to the stream finalizer and making the resume window configurable for tests. Reran CI locally.\\nSRE Team (CI bot) (2026-02-24): One lint failure in openai_compat_stream.go for an unused variable \xe2\x80\x94 fixed in follow-up commit.\\nAva Chen (2026-02-24): Approved after last fixes. Marking as ready to merge.", "score": 0.744045, "rank": 0, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}, {"chunk_id": "cd16a46d-74cc-580a-875c-465401a1b3e9", "search_unit_id": "cd16a46d-74cc-580a-875c-465401a1b3e9", "block_from_id": "ae8b6cdf-9bf6-5bbb-a815-9990fe1395ba", "block_to_id": "d1964765-27dd-5c46-aab3-4e24005cd79a", "section_path": "Sup 18510 Streaming Throughput Metric Mismatch", "document_id": "d164ca2a-1fef-5580-b76a-e8640c05b61e", "document_version_id": "9403367b-6c10-5fbb-bd00-38bc695b7e78", "document_name": "jira__dsid_a5a5235d973e421c870e11ceea4887ed.md", "version_no": 1, "page_from": 1, "page_to": 1, "anchor": "h1-0", "heading": "Sup 18510 Streaming Throughput Metric Mismatch", "content": "Sup 18510 Streaming Throughput Metric Mismatch\\n\\nSource type: jira\\nDocument ID: dsid_a5a5235d973e421c870e11ceea4887ed\\nRelease: v1.0.0\\nBenchmark: EnterpriseRAG-Bench synthetic upstream data\\nStreaming throughput metric mismatch (customer dashboard vs Redwood export) \xe2\x80\x94 suspected token accounting double-count in streaming\\n\\nCustomer (Vidorama) reports inconsistent throughput numbers for their Dedicated deployment when using streaming responses.\\n\\nIssue summary\\n\\n- Vidorama is comparing:\\n  1) Redwood Console throughput panel (tokens/sec) for their Dedicated deployment, and\\n  2) Their internal measurement based on streamed tokens (client-side) + Redwood usage export.\\n- They see Redwood Console tokens/sec ~1.8\xe2\x80\x932.1x higher than their client-side computed throughput for the same time windows.\\n- Discrepancy appears only for streaming (non-streaming requests match within ~5\xe2\x80\x9310%).\\n\\nImpact\\n\\n- Customer confusion + concern about Dedicated throughput SLO reporting accuracy.\\n- Potential false positives/negatives in SLO compliance if the canonical throughput metric is inflated for streaming.\\n\\nCustomer-provided details\\n\\n- Workload: chat completions, streaming enabled (server-sent events).\\n- Typical request: prompt 1\xe2\x80\x932k tokens, completion 150\xe2\x80\x93400 tokens, 20\xe2\x80\x9360 concurrent streams.\\n- Sampling window: 5-min rolling, comparing against their Prometheus counters.\\n\\nRedwood initial checks (Support)\\n\\n- Confirmed customer is hitting the correct deployment_id and region (us-east).\\n- Confirmed they are not mixing model variants in the comparison window (pinned to llama-3.1-70b-instruct; occasional mixtral bursts were excluded by customer).\\n- Confirmed they are not counting input tokens in their client throughput metric (they only count generated tokens).\\n\\nSteps to reproduce (internal)\\n1) Run load test against a Dedicated deployment with streaming enabled.\\n2) Compare:\\n\\n   - streaming token counter used by throughput dashboard (server-side), vs\\n   - sum(completion_tokens) from request final usage events (server-side) and/or reconstructed deltas.\\n\\n3) Observe that for streaming requests, the dashboard-aligned metric increases faster than final usage totals.\\n\\nInvestigation notes (SRE/Obs)\\n\\n- Hypothesis A: double-counting streamed completion tokens (both per-chunk deltas and final usage event contribute to the same counter).\\n- Hypothesis B: retries/resumes on stream reconnects cause duplicated deltas.\\n- Hypothesis C: mixed attribution labels (route vs deployment) cause aggregation overlap.\\n\\nFindings\\n\\n- We can reproduce consistent ~2x inflation when streaming is enabled and client consumes the full stream.\\n- Root cause identified in telemetry emission path:\\n  - For streaming responses, we emit per-chunk token deltas (used for near-real-time throughput).\\n  - At stream termination, a final usage event is emitted.\\n  - In the current pipeline, the dashboard throughput counter was incremented by BOTH the per-chunk deltas and the final usage event for the same request.\\n- This does NOT affect billing totals (billing uses finalized usage only). It affects the real-time throughput metric used in dashboards and SLO evaluation.\\n\\nWorkaround (until fix rollout)\\n\\n- For customer reporting, use finalized completion token metrics (request end) for streaming workloads:\\n  - completion_tokens_total (finalized) / wall time\\n- Avoid using real-time streaming throughput panel for contractual/SLO comparisons until patched.\\n\\nNext actions", "score": 0.701102, "rank": 1, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}, {"chunk_id": "f01e1322-a143-570f-b42b-445ad769f16f", "search_unit_id": "f01e1322-a143-570f-b42b-445ad769f16f", "block_from_id": "c01b4777-5362-543a-8f35-af538b2ca709", "block_to_id": "c5d100e9-1b17-5124-a1e5-377252248c20", "section_path": "Sup 18510 Streaming Throughput Metric Mismatch", "document_id": "d164ca2a-1fef-5580-b76a-e8640c05b61e", "document_version_id": "9403367b-6c10-5fbb-bd00-38bc695b7e78", "document_name": "jira__dsid_a5a5235d973e421c870e11ceea4887ed.md", "version_no": 1, "page_from": 1, "page_to": 1, "anchor": "list-21", "heading": "Sup 18510 Streaming Throughput Metric Mismatch", "content": "- Engineering to patch streaming accounting to ensure final usage does not also increment the streaming delta counter (or to separate metrics cleanly).\\n- Backfill: no backfill planned; we will annotate the dashboard for the affected time range and document the known issue.\\n- Customer comms: provide written explanation that billing is unaffected; commit to patch timeline and a short validation report post-deploy.\\n\\n2025-02-21 10:14 PT \xe2\x80\x94 Owen Phillips (Support): Customer ticket opened after Vidorama noticed Redwood Console tokens/sec ~2x their internal measurement on streaming. Non-streaming looks normal. Requesting SRE/Obs help; tagging Aisha Bello.\\n2025-02-21 12:02 PT \xe2\x80\x94 Aisha Bello (SRE): Acknowledged. Pulling metrics for deployment_id provided by customer. Initial glance: tokens/sec is unusually spiky and high during periods dominated by streaming traffic.\\n2025-02-22 09:37 PT \xe2\x80\x94 Sergio Costa (Observability): I can reproduce in staging with a scripted SSE client. Suspect dashboard is aggregating both stream deltas and final usage. Need confirm on emitter path in serving-runtime.\\n2025-02-23 14:18 PT \xe2\x80\x94 Logan Wright (Telemetry): Found candidate: token counter increments on chunk delta AND again on finalize handler. This would produce ~2x under full consumption. Filing fix with serving-runtime owners.\\n2025-02-24 11:26 PT \xe2\x80\x94 Aisha Bello (SRE): Confirmed billing exports are correct (final usage only). The problematic series is the near-real-time throughput metric used in the dashboard and SLO evaluator. Recommending we temporarily treat streaming throughput dashboard values as best-effort until patch.\\n2025-02-25 16:40 PT \xe2\x80\x94 Owen Phillips (Support): Sent customer interim update: billing unaffected; mismatch is in streaming throughput visualization/metric; offered workaround using finalized usage tokens. Customer asked whether this impacts Dedicated SLO credits\xe2\x80\x94told them we will validate SLO evaluator inputs and share fix ETA.\\n2025-02-27 13:05 PT \xe2\x80\x94 Aisha Bello (SRE): Fix PR is up: sources/github/redwood/pr-19422-fix-throughput-metric-double-counting-streaming.json. Plan: canary in us-east Dedicated pools first, then global rollout if stable.\\n2025-03-01 09:22 PT \xe2\x80\x94 Aisha Bello (SRE): Patch deployed to prod/us-east. Verified in internal load test: streaming tokens/sec now matches finalized usage within ~3\xe2\x80\x936% over 5m windows. Monitoring for 24h; no regressions so far.\\n2025-03-02 10:11 PT \xe2\x80\x94 Owen Phillips (Support): Customer confirmed their numbers now align with Redwood Console within expected variance. Closing ticket. Follow-up: add dashboard annotation for 2025-02-10 through 2025-03-01 and link to known issue in Dedicated throughput SLO FAQ.\\nResolved by patching streaming token accounting to prevent double-counting (per-chunk deltas + final usage). Deployed to prod/us-east on 2025-03-01 and validated against load tests and customer confirmation. Billing was not impacted. Ticket closed after customer confirmed metrics alignment.", "score": 0.46927, "rank": 2, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}, {"chunk_id": "f46bcbd0-ed4e-5054-a586-356fe2b31a43", "search_unit_id": "f46bcbd0-ed4e-5054-a586-356fe2b31a43", "block_from_id": "1402985c-6c5e-5c98-ae84-7896c4a28772", "block_to_id": "1402985c-6c5e-5c98-ae84-7896c4a28772", "section_path": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "document_id": "6462f8ed-eae8-5b6d-a5f1-30143420f402", "document_version_id": "fa43fa2f-e842-5aa1-9ba5-06c4e55756a2", "document_name": "github__dsid_9550250a59e74f1bbd5612480b2e7100.md", "version_no": 1, "page_from": 1, "page_to": 1, "anchor": "p-2", "heading": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "content": "Server-side streaming timebox (route-configurable) that guarantees a graceful terminal event when streams exceed a configured residency time. Client Cancel events are now idempotent within a short resume window; resume tokens include minimal idempotency hints to avoid duplicated tool/function executions on reconnect. Default behavior unchanged unless enabled per-route.", "score": 0.41849, "rank": 3, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}, {"chunk_id": "58dcd8bb-2a68-567e-aaea-d6dd36feb95f", "search_unit_id": "58dcd8bb-2a68-567e-aaea-d6dd36feb95f", "block_from_id": "f53b7c5d-ab9f-5a43-bef4-7bf6ccfc5be6", "block_to_id": "e2732f67-34ab-5ae7-9cc3-d60c8a4a937a", "section_path": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "document_id": "6462f8ed-eae8-5b6d-a5f1-30143420f402", "document_version_id": "fa43fa2f-e842-5aa1-9ba5-06c4e55756a2", "document_name": "github__dsid_9550250a59e74f1bbd5612480b2e7100.md", "version_no": 1, "page_from": 1, "page_to": 1, "anchor": "h1-0", "heading": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "content": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat\\n\\nSource type: github\\nDocument ID: dsid_9550250a59e74f1bbd5612480b2e7100\\nRelease: v1.0.0\\nBenchmark: EnterpriseRAG-Bench synthetic upstream data\\nintroduce-server-timebox-and-idempotent-cancel-fallbacks-for-streaming-compat", "score": 0.3834, "rank": 4, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}], "events": [], "entities": [], "relations": [], "source_hits": [], "summary": "The new metric added to track when server-side streaming sessions get finalized due to hitting the time limit is \\"stream.timebox_finalized\\" with labels for route and model. This metric was introduced as part of the changes in Pr 129874 [1].", "citations": [{"kind": "internal", "n": 1, "document_id": "6462f8ed-eae8-5b6d-a5f1-30143420f402", "document_version_id": "fa43fa2f-e842-5aa1-9ba5-06c4e55756a2", "document_name": "github__dsid_9550250a59e74f1bbd5612480b2e7100.md", "version_no": 1, "chunk_id": "77ccfbb4-2766-53e1-9c48-7d6a54f34ff5", "search_unit_id": "77ccfbb4-2766-53e1-9c48-7d6a54f34ff5", "block_from_id": "1402985c-6c5e-5c98-ae84-7896c4a28772", "block_to_id": "1402985c-6c5e-5c98-ae84-7896c4a28772", "section_path": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "page_from": 1, "page_to": 1, "anchor": "p-2", "heading": "Pr 129874 Timebox Abort Idempotency Resume Openai Compat", "snippet": "Context: production customers observed cases where long lived streaming sessions (tool calls + structured output) were left in indeterminate states after a client network disconnect or a client-initiated Cancel. Motivation: we need a predictable server-side safety net that bounds resource residency time, ensures tool-call idempotency when retries/resume occur, and provides a clear fallback path (trimmed response + final event) that OpenAI-compatible clients can rely on. This PR implements a server-side streaming timebox (configurable per-route) that gracefully converts oversized/inflight streams into a final \'timeboxed\' terminal event, augments client-cancel handling to be idempotent across reconnect/resume win\xe2\x80\xa6", "score": 0.744, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}], "answer_status": "answered", "no_answer_reason": null, "exploration_id": null, "stats": {"canonical_index": true, "ready_versions": 81, "requested_top_k": null, "candidate_top_k": 32, "candidate_unit_pool_limit": 1024, "candidate_pool_saturated": true, "candidate_units_before_cap": 83, "candidate_units_after_cap": 83, "candidate_units_truncated": 0, "semantic_candidates": 43, "lexical_candidates": 45, "candidates": 83, "relevant": 83, "filtered_irrelevant": 0, "fusion_method": "rrf", "selection_method": "authorized_content_dedup_mmr", "cross_scope_merge": "rank_interleave", "coverage": {"candidate_count": 64, "deduplicated_count": 0, "diversity_weight": 0.5, "near_duplicate_similarity": 0.98, "required_anchor_count": 0, "covered_anchor_count": 0, "anchor_coverage": "not_required", "status": "unknown", "canonical_locator_verified": true, "semantic_answerability": "unknown"}, "routing": {"planner": {"planner_version": "qsp-v1