urity to approve access to a high risk internal tool role in Redwood\'s tool access governance process?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "KNOWLEDGE", "confidence": 0.9346, "model": "Kev-4b", "suggested_strategy": "vector", "requested_strategy": "auto", "effective_strategy": "vector", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["KNOWLEDGE_INTENT"], "query_analysis": {"normalized_phrase": "whatistheexpectedturnaroundtimeforsecuritytoapproveaccesstoahighriskinternaltoolroleinredwoodstoolaccessgovernanceprocess", "lookup_terms": ["expected", "turnaround", "time", "security", "approve", "access", "high", "risk", "internal", "tool", "role", "redwood", "governance", "process", "whatistheexpectedturnaroundtimeforsecuritytoapproveaccesstoahighriskinternaltoolroleinredwoodstoolaccessgovernanceprocess"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "LOCAL_FACTUAL", "modifiers": [], "reason_codes": ["DEFAULT_LOCAL_FACTUAL"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
