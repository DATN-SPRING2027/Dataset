rts and speed up root cause analysis?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "AMBIGUOUS", "confidence": 0.5025, "model": "Kev-4b", "suggested_strategy": "multi", "requested_strategy": "auto", "effective_strategy": "multi", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["INTENT_CONFIDENCE_LOW"], "query_analysis": {"normalized_phrase": "howdoesthenewalertingapproachgroupmodelservingrequestsbythestagestheypassthroughtoreducenoisyalertsandspeeduprootcauseanalysis", "lookup_terms": ["new", "alerting", "approach", "group", "model-serving", "requests", "stages", "they", "pass", "through", "reduce", "noisy", "alerts", "speed", "root", "cause"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "LOCAL_FACTUAL", "modifiers": [], "reason_codes": ["DEFAULT_LOCAL_FACTUAL"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
