nt": 64, "deduplicated_count": 0, "diversity_weight": 0.5, "near_duplicate_similarity": 0.98, "required_anchor_count": 0, "covered_anchor_count": 0, "anchor_coverage": "not_required", "status": "unknown", "canonical_locator_verified": true, "semantic_answerability": "unknown"}, "selection_fallback_reason": null, "multi_hop": {"eligible": false, "effective": "LOCAL_FACTUAL", "graph_expansion_attempted": false, "graph_expanded_candidates": 0, "graph_expansion_skip_reason": null}, "fallback_used": true}, "selection_fallback_reason": null, "stage_latencies_ms": {"auth_scope": 11.97, "tree_route": 877.77, "candidate_retrieval": 2208.39, "evidence_hydration": 17.16, "rank_fusion": 36.07, "graph_expansion": 0.0, "diversity_selection": 1939.51, "total_retrieval": 5102.35}, "latency_total_ms": 5102.35, "automatic_top_k": true, "effective_top_k": 3, "adaptive_waves": 1, "retrieval_stop_reason": "relevance_plateau", "budget_exhausted": false, "has_more": false, "acl_filtered_candidates": 0, "query_route": {"version": "query-flow-v1", "query_original": "In the EdgePath evaluation email thread, what alternative Year 1 pricing package did Redwood propose instead of matching the competitor\'s 50 percent first-year discount and migration credit?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "KNOWLEDGE", "confidence": 0.7988, "model": "Kev-4b", "suggested_strategy": "vector", "requested_strategy": "auto", "effective_strategy": "vector", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["KNOWLEDGE_INTENT"], "query_analysis": {"normalized_phrase": "intheedgepathevaluationemailthreadwhatalternativeyear1pricingpackagedidredwoodproposeinsteadofmatchingthecompetitors50percentfirstyeardiscountandmigrationcredit", "lookup_terms": ["edgepath", "evaluation", "email", "thread", "alternative", "year", "pricing", "package", "redwood", "propose", "instead", "matching", "competitor", "50", "percent", "first-year"], "features":