 "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "EXACT", "modifiers": [], "reason_codes": ["EXACT_IDENTIFIER_PRESENT"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
