h", "evaluation", "email", "thread", "alternative", "year", "pricing", "package", "redwood", "propose", "instead", "matching", "competitor", "50", "percent", "first-year"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": [], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "LOCAL_FACTUAL", "modifiers": [], "reason_codes": ["DEFAULT_LOCAL_FACTUAL"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
