ass of \'ghost\' entries in the KV prefix cache: entries whose refcount had decayed below zero (underflow) due to an interaction between async compaction, prefetch migration, and a recent refcount optimization. These ghost entries never surfaced as normal cache misses and therefore were not collected by the existing eviction heuristics, leading to gradual slab exhaustion on hot shards. This ticket captures detection heuristics, an emergency snapshot sanitization runbook, a staged rolling-heal design\xe2\x80\xa6", "score": 0.8282, "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "source_name": "Project b3086c26ae3c45b6b8710f3c"}], "answer_status": "answered", "no_answer_reason": null, "exploration_id": null, "stats": {"canonical_index": true, "ready_versions": 81, "requested_top_k": null, "candidate_top_k": 32, "candidate_unit_pool_limit": 1024, "candidate_pool_saturated": true, "candidate_units_before_cap": 81, "candidate_units_after_cap": 81, "candidate_units_truncated": 0, "semantic_candidates": 47, "lexical_candidates": 46, "candidates": 81, "relevant": 47, "filtered_irrelevant": 34, "fusion_method": "rrf", "selection_method": "authorized_content_dedup_mmr", "cross_scope_merge": "rank_interleave", "coverage": {"candidate_count": 64, "deduplicated_count": 0, "diversity_weight": 0.5, "near_duplicate_similarity": 0.98, "required_anchor_count": 0, "covered_anchor_count": 0, "anchor_coverage": "not_required", "status": "unknown", "canonical_locator_verified": true, "semantic_answerability": "unknown"}, "routing": {"planner": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "TEMPORAL", "modifiers": [], "reason_codes": ["TEMPORAL_CUE_PRESENT"], "multi_hop_eligible": false}, "request_snapshot_id": "dac44c32-6713-471c-9e7d-da30946e648d", "groups": [{"project_id": "b3086c26ae3c45b6b8710f3c", "source_id": "b17fa25ce7d34acab77e3ad6267b5159", "partition_id": "b3086c26ae3c45b6b8710f3c", "snapshot_id": "c625d178-d921-46ff-a329-847fbce6914f", "re