 promotion pipelines, including how to cut over safely and roll back if something goes wrong?", "scope_source_ids": ["b17fa25ce7d34acab77e3ad6267b5159"], "coarse_intent": "KNOWLEDGE", "confidence": 0.6671, "model": "Kev-4b", "suggested_strategy": "vector", "requested_strategy": "auto", "effective_strategy": "vector", "retrieval": "required", "fallback_used": false, "fallback_reason": null, "reason_codes": ["KNOWLEDGE_INTENT", "RELATION_CUE"], "query_analysis": {"normalized_phrase": "whatistherecommendedtwostageprocessforrotatingthesigningcredentialsusedbygpuimagebuildandpromotionpipelinesincludinghowtocutoversafelyandrollbackifsomethinggoeswrong", "lookup_terms": ["recommended", "two-stage", "process", "rotating", "signing", "credentials", "used", "gpu", "image", "build", "promotion", "pipelines", "including", "cut", "safely", "roll"], "features": {"exact_terms": [], "identifier_terms": [], "path_terms": [], "temporal_cues": [], "relation_cues": ["used by"], "global_cues": [], "multi_hop": false}}, "strategy_plan": {"planner_version": "qsp-v1", "requested_strategy": "AUTO", "effective_strategy": "ENTITY_RELATIONAL", "modifiers": [], "reason_codes": ["RELATION_CUE_PRESENT"], "multi_hop_eligible": false}, "retrieval_fallback_used": false}}}\r\n\r\n'
